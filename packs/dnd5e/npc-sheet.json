{
  "sections": [
    {
      "title": "Identity",
      "columns": 3,
      "fields": [
        {
          "kind": "text",
          "bind": "name",
          "label": "Name"
        },
        {
          "kind": "text",
          "bind": "size",
          "label": "Size"
        },
        {
          "kind": "text",
          "bind": "creature_type",
          "label": "Type"
        },
        {
          "kind": "text",
          "bind": "alignment",
          "label": "Alignment"
        },
        {
          "kind": "text",
