{
  "id": "dnd5e",
  "name": "D&D 5e (SRD)",
  "version": "0.3.0",
  "description": "Fifth edition fantasy from the System Reference Document 5.1: six abilities, proficiency bonus, d20 attacks against Armor Class, saving throws against a DC, spell slots, damage types with resistances, temporary hit points, concentration and 4d6-drop-lowest character creation. Includes the SRD 5.2.1 and SRD 5.1 creature stat blocks with an NPC sheet and the SRD 5.2.1 encounter XP budget.",
  "license": "Mechanics and content from the SRD 5.1 and the SRD 5.2.1 by Wizards of the Coast LLC under CC-BY-4.0; see LICENSE.md for the attribution notices. No Player's Handbook-only content.",
  "grid": { "type": "square", "cellSize": 1.5 },
  "resolution": { "kind": "d20-vs-dc" },
  "damage": {
    "resource": "hp",
    "temp": "temp_hp",
    "resist": "resistances",
    "vulnerable": "vulnerabilities",
    "immune": "immunities",
    "types": [
      { "id": "acid", "name": "Acid" },
      { "id": "bludgeoning", "name": "Bludgeoning" },
      { "id": "cold", "name": "Cold" },
      { "id": "fire", "name": "Fire" },
      { "id": "force", "name": "Force" },
      { "id": "lightning", "name": "Lightning" },
      { "id": "necrotic", "name": "Necrotic" },
      { "id": "piercing", "name": "Piercing" },
      { "id": "poison", "name": "Poison" },
      { "id": "psychic", "name": "Psychic" },
      { "id": "radiant", "name": "Radiant" },
      { "id": "slashing", "name": "Slashing" },
      { "id": "thunder", "name": "Thunder" }
    ]
  },
  "concentration": {
    "condition": "concentrating",
    "save": "d20 + con_mod + save_prof.con * pb",
    "dc": "max(10, floor(damage / 2))"
  },
  "files": {
    "attributes": "attributes.json",
