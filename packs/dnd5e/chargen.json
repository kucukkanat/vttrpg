        "slots_3.max": "caster == 'full' ? (level >= 6 ? 3 : level == 5 ? 2 : 0) : caster == 'half' ? (level >= 11 ? 3 : level >= 9 ? 2 : 0) : caster == 'pact' ? (level == 5 or level == 6 ? 2 : 0) : 0",
        "slots_3.current": "slots_3.max"
      }
    }
