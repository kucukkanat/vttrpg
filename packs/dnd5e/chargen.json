        "hp.max": "hit_die_sides + con_mod",
        "hp.current": "hp.max",
        "hit_dice.max": "level",
        "hit_dice.current": "hit_dice.max",
        "slots_1.max": "caster == 'full' ? (level >= 3 ? 4 : level + 1) : caster == 'half' ? (level >= 5 ? 4 : level >= 3 ? 3 : level == 2 ? 2 : 0) : caster == 'pact' ? (level == 1 ? 1 : level == 2 ? 2 : 0) : 0",
        "slots_1.current": "slots_1.max",
        "slots_2.max": "caster == 'full' ? (level >= 4 ? 3 : level == 3 ? 2 : 0) : caster == 'half' ? (level >= 7 ? 3 : level >= 5 ? 2 : 0) : caster == 'pact' ? (level == 3 or level == 4 ? 2 : 0) : 0",
