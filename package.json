{
  "name": "vttrpg",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:check": "npm run build && node scripts/check-bundle.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "lint": "eslint src",
    "library:index": "node scripts/build-library-index.mjs",
    "scenes": "node scripts/make-scenes/index.mjs && node scripts/build-library-index.mjs",
    "props": "node scripts/make-props/index.mjs && node scripts/build-library-index.mjs",
    "creatures": "node scripts/build-creatures/index.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.14.0",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/rapier": "^2.2.0",
    "fflate": "^0.8.3",
    "immer": "^10.1.1",
    "meshoptimizer": "^1.3.0",
    "nostr-tools": "^2.25.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0",
    "yjs": "^13.6.33",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^5.0.0",
    "fake-indexeddb": "^6.2.7",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.0"
  }
}
